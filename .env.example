LANDSCAPE_LOCUST_HOST=https://landscape.example.com

# Email/password login (mutually exclusive with access key login below)
LANDSCAPE_LOCUST_EMAIL=john@example.com
LANDSCAPE_LOCUST_PASSWORD=pwd

# Access key login (takes precedence over email/password if both are set)
# LANDSCAPE_LOCUST_ACCESS_KEY=your-access-key
# LANDSCAPE_LOCUST_SECRET_KEY=your-secret-key

LANDSCAPE_LOCUST_USERS=1000
LANDSCAPE_LOCUST_SPAWN_RATE=50
LANDSCAPE_LOCUST_WORKERS=2

LANDSCAPE_LOCUST_EXCHANGE_SERVER_DB_HOST=your-db-host
LANDSCAPE_LOCUST_EXCHANGE_SERVER_DB_NAME=landscape-standalone-main
LANDSCAPE_LOCUST_EXCHANGE_SERVER_DB_USER=landscape
LANDSCAPE_LOCUST_EXCHANGE_SERVER_DB_PASSWORD=landscape
LANDSCAPE_LOCUST_EXCHANGE_SERVER_DB_PORT=5432
LANDSCAPE_LOCUST_EXCHANGE_SERVER_PORT=9999
